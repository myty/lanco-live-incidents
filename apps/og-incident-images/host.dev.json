{
  "version": "2.0",
  "watchFiles": [
    "main.ts"
  ],
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": "deno",
      "workingDirectory": "/app",
      "arguments": [
        "task",
        "dev"
      ]
    },
    "enableForwardingHttpRequest": true
  }
}
